# End-to-end test configuration — copy to .env.e2e and fill in.
#
#   cp .env.e2e.example .env.e2e      # then edit
#   set -a; source .env.e2e; set +a   # load into the shell (bash/zsh)
#   npm run e2e                        # web (Playwright)
#
# .env.e2e is gitignored — never commit real credentials.
# Point everything at a THROWAWAY workspace (ideally a separate Supabase
# project), never a customer tenant. See tests/e2e/README.md for the full rules.

# ─────────────────────────────────────────────────────────────────────────────
# WEB — Playwright (tests/e2e/)
# ─────────────────────────────────────────────────────────────────────────────

# Base URL. Leave unset to use the local dev server (http://localhost:5173),
# which Playwright starts for you.
# E2E_BASE_URL=http://localhost:5173

# Sign-in credentials, one per role. Omit a role to skip its specs.
# The tenant account is the workspace OWNER (needed for billing/settings specs).
E2E_TENANT_EMAIL=owner@yourtest.com
E2E_TENANT_PASSWORD=
E2E_HM_EMAIL=hm@yourtest.com
E2E_HM_PASSWORD=
E2E_INTERVIEWER_EMAIL=interviewer@yourtest.com
E2E_INTERVIEWER_PASSWORD=

# An OPEN job in the test workspace (from its apply link: /apply/<jobId>).
# Drives the apply page, applicants, AI Rank, interviews and hiring-pipeline specs.
E2E_APPLY_JOB_ID=
# Optional: a DRAFT job, to cover the draft apply-page state.
E2E_DRAFT_JOB_ID=

# Safety gates — NOT read from this file, on purpose. Playwright loads
# everything above but deliberately ignores these three, because they decide
# whether a run creates real rows, spends real credits and sends real email
# against the LIVE project, and a value left in a file is not a decision to do
# any of that. Pass them on the command that runs the tests, so switching one on
# is something you did rather than something you inherited:
#
#   E2E_ALLOW_WRITES=1 npm run e2e          # create/edit tenant rows
#   E2E_ALLOW_AI=1 npm run e2e              # spend real AI credits
#   E2E_ALLOW_EMAIL=1 npm run e2e           # send real email
#
# Putting E2E_ALLOW_WRITES=1 in this file does nothing.

# ─────────────────────────────────────────────────────────────────────────────
# MOBILE — Maestro (mobile/.maestro/)
# ─────────────────────────────────────────────────────────────────────────────
# Not read from this file by Maestro — pass on the CLI with -e, e.g.:
#   cd mobile && npm run e2e -- -e ASTER_PASSWORD="$ASTER_PASSWORD"
# ASTER_EMAIL defaults to the seeded demo tenant (tenant@onlazy.com).
ASTER_EMAIL=tenant@onlazy.com
ASTER_PASSWORD=
